{
  "routes": [
    { "route": "/manifest.json", "allowedRoles": ["anonymous"] },
    { "route": "/icons/*", "allowedRoles": ["anonymous"] },
    { "route": "/admin/*", "allowedRoles": ["admin"] },
    { "route": "/api/gestao/*", "allowedRoles": ["admin"] },
    { "route": "/api/*", "allowedRoles": ["tecnico", "admin"] },
    { "route": "/*", "allowedRoles": ["tecnico", "admin"] }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}